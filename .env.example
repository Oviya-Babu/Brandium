# Copy to .env for local development. Never commit the real .env
# (git-ignored) — see technology_stack.md v1.1 §17.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://brandium:brandium@localhost:5432/brandium
SQL_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (Technology Stack v1.1 §6)
QDRANT_URL=http://localhost:6333

# MinIO / S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=brandium
S3_SECRET_KEY=brandium-dev-secret
S3_BUCKET_NAME=brandium-assets
S3_REGION=us-east-1

# Ollama — primary self-hosted LLM + embedding runtime (Technology Stack v1.1 §14/§15)
OLLAMA_BASE_URL=http://localhost:11434
# `qwen3:4b` — not `qwen3:8b-instruct`, which is not a real Ollama tag.
# Default is the 4B model for latency/resource footprint; set to
# `qwen3:8b` (same family) if your host has the headroom.
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Groq — automatic fallback when Ollama is unavailable or fails (leave unset to disable the fallback)
GROQ_API_KEY=
GROQ_NARRATION_MODEL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
